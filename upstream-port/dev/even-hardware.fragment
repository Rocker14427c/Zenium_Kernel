# even (MT6769) hardware enablement, derived by bin/hwenable.py from the
# built mt6768.dtb: every driver that actually matches a node in this board's
# device tree, that 5.15 has, and that this build left off.  Enable them and
# `make olddefconfig` decides which survive their dependencies.
CONFIG_DEVAPC_MT6768=y

# mt6768 clock provider (CCF) + MTCMOS power gating. Keyed off MACH_MT6768 by its
# Kconfig default, listed explicitly so the device config does not depend on a default.
# Audited, not just enabled: report/clkaudit.json - 231 clock refs in this board's DTB,
# 209 resolve to an ID the driver registers, 0 foreign-numbering. Known incompleteness:
# peri_clks[] carries 1 gate (the BSP left pericfg CGs to its legacy clkmgr); the base
# DTB makes zero CLK_PERI references, so nothing on this board is blocked by it today -
# but any mainline-style driver added later that asks for a pericfg gate will need that
# table filled from the vendor CG data, not from a guess.
CONFIG_COMMON_CLK_MT6768=y

# PMIC: the pwrap wrapper, the MT6358 MFD it feeds, and the cell drivers that can
# bind today.  Enabled together because each is a hard dependency of the next: pwrap
# must probe first (it is the regmap provider), mt6397-core turns the PMIC node into
# cells, and only then can the regulator/rtc/auxadc drivers match those cells.
# Aliases added to the two of_match tables for this DTB's "mediatek,mt6358-pmic" name
# are justified in the driver comments; register layout evidence in report/hardware-enablement.md.
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6358=y
CONFIG_MEDIATEK_MT6577_AUXADC=y

# AUXADC: SoC provider (aliased to MT6765's description, which is what the vendor's own
# mt6768 entry uses) and the MT6358 PMIC converter, transplanted as the variant this board's
# 4.19 defconfig builds (CONFIG_MT635X_AUXADC=y there). The PMIC driver needs the MFD cell
# added in mt6397-core.c; without it the DTB's mt635x-auxadc node never becomes a device.
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_MT635X_AUXADC=y

# eMMC host = the root device. MT6768 is described field-for-field by mainline's mt6779_compat
# (verified against the vendor's own mt6768_compat), and MMC_MTK_PRO (the BSP's proprietary
# host driver for the duplicate msdc@ nodes) is impossible by Kconfig once MMC_MTK is on -
# that exclusion is what keeps two drivers off one controller. CQ stays off: mainline keys it
# on `supports-cqe`, which this DTB does not carry.
CONFIG_MMC_MTK=y
CONFIG_MMC_BLOCK=y

# CMDQ mailbox host for the display path. This was in no fragment before the L1 gate, which is how
# the series carried +460 lines of vendor delta into drivers/mailbox/mtk-cmdq-mailbox.c without any
# build ever compiling it (build-33..37 reported 0 errors with this driver absent from .config).
# MTK_INFRACFG is selected by MTK_CMDQ_MBOX and MAILBOX is its parent, so all three are named here
# rather than left to defaults. MTK_CMDQ_MBOX_EXT and MTK_MT6382_BDG stay off, matching
# even_defconfig:1807 and the fact that cmdq/mailbox/ and cmdq/bridge/ are not built for mt6768.
CONFIG_MAILBOX=y
CONFIG_MTK_INFRACFG=y
CONFIG_MTK_CMDQ_MBOX=y

# Display bias PMIC (MT6370 sub-PMIC on i2c5 @0x34), mirroring even_defconfig:1687-1693. These are
# board symbols, not display symbols: stock enables the sub-PMIC whether or not the display path is
# built, and CONFIG_MT6370_PMU_DSV in particular is the switch lcm_pmic.c's bias branch reads, so it
# has to be on in the config of record or the port silently builds the vendor "#else" stubs.
# CONFIG_RT_REGMAP is not named here: MFD_MT6370_PMU selects it, which is what keeps
# mt6370_pmu_regmap.c's "#ifdef CONFIG_RT_REGMAP" body alive - without it mt6370_pmu_core.c:166
# would call rt_regmap_cache_reload() with chip->rd NULL.
CONFIG_MFD_MT6370_PMU=y
CONFIG_MT6370_PMU_DSV=y
