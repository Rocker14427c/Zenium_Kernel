# even (MT6769) hardware enablement, derived by bin/hwenable.py from the
# built mt6768.dtb: every driver that actually matches a node in this board's
# device tree, that 5.15 has, and that this build left off.  Enable them and
# `make olddefconfig` decides which survive their dependencies.
CONFIG_DEVAPC_MT6768=y

# mt6768 clock provider (CCF) + MTCMOS power gating. Keyed off MACH_MT6768 by its
# Kconfig default, listed explicitly so the device config does not depend on a default.
# Audited, not just enabled: report/clkaudit.json - 231 clock refs in this board's DTB,
# 209 resolve to an ID the driver registers, 0 foreign-numbering. Known incompleteness:
# peri_clks[] carries 1 gate (the BSP left pericfg CGs to its legacy clkmgr); the base
# DTB makes zero CLK_PERI references, so nothing on this board is blocked by it today -
# but any mainline-style driver added later that asks for a pericfg gate will need that
# table filled from the vendor CG data, not from a guess.
CONFIG_COMMON_CLK_MT6768=y

# PMIC: the pwrap wrapper, the MT6358 MFD it feeds, and the cell drivers that can
# bind today.  Enabled together because each is a hard dependency of the next: pwrap
# must probe first (it is the regmap provider), mt6397-core turns the PMIC node into
# cells, and only then can the regulator/rtc/auxadc drivers match those cells.
# Aliases added to the two of_match tables for this DTB's "mediatek,mt6358-pmic" name
# are justified in the driver comments; register layout evidence in report/hardware-enablement.md.
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6358=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
