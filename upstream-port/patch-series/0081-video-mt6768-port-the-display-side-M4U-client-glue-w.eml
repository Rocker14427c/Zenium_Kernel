@@ -0,0 +1,18 @@
+#
+# MT6768 display-side M4U client glue (ported subset of the vendor dispsys).
+#
+# The vendor video/mt6768/dispsys/Makefile builds the whole display core
+# (ddp_drv.o, ddp_disp_bdg.o, ddp_dsi.o, ...) and reaches for cmdq, ged,
+# staging/android/mtk_ion and dramc include paths. Only the M4U client glue is
+# ported, so only that object is built and the include list is limited to the
+# paths this file actually resolves against (m4u platform + core headers and
+# the video include dirs), taken from the vendor rule verbatim otherwise.
+#
+
+ccflags-y += -I$(srctree)/drivers/misc/mediatek/video/include \
+             -I$(srctree)/drivers/misc/mediatek/video/mt6768/videox \
+             -I$(srctree)/drivers/misc/mediatek/include \
+             -I$(srctree)/drivers/misc/mediatek/m4u/2.0 \
+             -I$(srctree)/drivers/misc/mediatek/m4u/mt6768
+
+obj-y += ddp_m4u.o
