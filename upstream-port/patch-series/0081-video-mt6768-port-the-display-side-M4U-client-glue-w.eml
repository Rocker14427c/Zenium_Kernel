diff --git a/drivers/misc/mediatek/video/mt6768/dispsys/ddp_log.h b/drivers/misc/mediatek/video/mt6768/dispsys/ddp_log.h
new file mode 100644
index 000000000..814ac4f32
--- /dev/null
+++ b/drivers/misc/mediatek/video/mt6768/dispsys/ddp_log.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Port-local log layer for the MT6768 display M4U client.
+ *
+ * The vendor video/mt6768/dispsys/ddp_log.h and video/mt6768/videox/
+ * disp_drv_log.h route every message through the display recorder
+ * (dprec_logger_pr(), video/mt6768/dispsys/display_recorder.c) and gate some
+ * levels on ddp_debug's dynamic log levels (ddp_debug.c). Those two files are
+ * part of the dispsys core, not of this client's closure, and pulling them in
+ * would also pull cmdq (cmdq_record.h/cmdq_core.h) and mmprofile tracing.
+ *
+ * So the client uses the vendor's *fallback* arm of each macro verbatim
+ * (pr_debug for INFO/MSG/CHECK, pr_info for WARN/ERR) and drops the dprec
+ * mirror. Consequence, stated plainly: these messages reach the kernel log
+ * only; /dev/pmsg/dprec recording of display M4U events is unavailable.
+ * DDPMSG is pr_info rather than the vendor's pr_err-if-g_mobilelog, so the
+ * one-time "register m4u callback" line is visible without the mobile-log
+ * switch that does not exist in this tree.
+ */
+#ifndef _H_DDP_LOG_PORT_
+#define _H_DDP_LOG_PORT_
+
+#ifndef LOG_TAG
+#define LOG_TAG
+#endif
+
+#define DISPINFO(string, args...)					\
+	do {								\
+		pr_debug("[DISP]" string, ##args);			\
+	} while (0)
+
+#define DISPMSG(string, args...)	pr_debug("[DISP]" string, ##args)
+#define DISPCHECK(string, args...)	pr_debug("[DISP]" string, ##args)
+
+#define DISPWARN(string, args...)						\
+	do {									\
+		pr_info("[DISP][%s #%d]warn:" string,				\
+				__func__, __LINE__, ##args);			\
+	} while (0)
+
+#define DISPERR(string, args...)						\
+	do {									\
+		pr_info("[DISP][%s #%d]ERROR:" string,				\
+				__func__, __LINE__, ##args);			\
+	} while (0)
+
+#define DDPDBG(fmt, args...)		pr_debug("[DDP/" LOG_TAG "]" fmt, ##args)
+#define DDPMSG(fmt, args...)		pr_info("[DDP/" LOG_TAG "]" fmt, ##args)
+#define DDPERR(fmt, args...)		pr_err("[DDP/" LOG_TAG "]" fmt, ##args)
+
+#endif /* _H_DDP_LOG_PORT_ */
