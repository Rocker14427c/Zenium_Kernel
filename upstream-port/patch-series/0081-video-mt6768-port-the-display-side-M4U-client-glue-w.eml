--- /dev/null
+++ b/drivers/misc/mediatek/video/Kconfig
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Ported MT6768 display-side M4U client glue.
+#
+# The vendor tree gates the whole display subsystem behind MTK_FB (plus
+# MTK_LCM/MTK_VIDEOX for the legacy fb path). None of that is needed by the
+# M4U client, so this Kconfig carries only the client and does not resurrect
+# the vendor's menu.
+
+config MTK_DISP_M4U
+	bool "MediaTek MT6768 display M4U client glue"
+	depends on MTK_M4U
+	default y
+	help
+	  Ported subset of the MT6768 display driver that talks to the M4U
+	  v2.0 media IOMMU: the display-module-to-port table, the fault
+	  callback registration, m4u_config_port() for OVL0/OVL0_2L/RDMA0/
+	  WDMA0, the kernel VA mapping helper, and the LK frame-buffer
+	  handover that books a fixed MVA for the boot logo.
+
+	  The rest of the display stack (dispsys core, DSI, LCM, the legacy
+	  mtkfb videox path) is not ported, so nothing in this tree calls the
+	  helpers yet; they are built so that the client-side contract with
+	  M4U and SMI is compiled, linked and ABI-checked against the real
+	  driver headers rather than assumed. Display buffer allocation
+	  through the vendor ION multimedia heap is deliberately not
+	  provided.
+
+	  If unsure, say Y.
