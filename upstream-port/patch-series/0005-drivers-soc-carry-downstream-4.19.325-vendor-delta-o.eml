+					"VIO_MASK", i,
+					readl(mtk_devapc_pd_get(slave_type,
+							VIO_MASK, i)),
+					"VIO_STA", i,
+					readl(mtk_devapc_pd_get(slave_type,
+							VIO_STA, i))
