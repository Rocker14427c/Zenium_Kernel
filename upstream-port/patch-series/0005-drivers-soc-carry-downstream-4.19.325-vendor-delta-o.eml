+void dump_dbg_info(void)
+{
+	uint32_t dbg0 = 0;
+	uint32_t write_vio, read_vio;
+	uint32_t vio_addr_high;
+	int i;
+	void __iomem *vio_dbg0_reg, *vio_dbg1_reg;
