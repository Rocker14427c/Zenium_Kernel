+#define PLAT_VIO_MAX_IDX		525
+#define PLAT_VIO_MASK_STA_NUM		17
+#define PLAT_VIO_SHIFT_MAX_BIT		25
+
+/******************************************************************************
+ * DATA STRUCTURE
+ ******************************************************************************/
+/* violation index corresponds to subsys */
+enum MFGSYS_INDEX {
+	MFGSYS_START = 232,
+	MFGSYS_END = 244,
+};
+
+enum SMI_INDEX {
+	SMI_LARB0 = 268,
+	SMI_LARB1 = 269,
+	SMI_COMMON = 270,
+	SMI_LARB5 = 294,
+	SMI_LARB6 = 295,
