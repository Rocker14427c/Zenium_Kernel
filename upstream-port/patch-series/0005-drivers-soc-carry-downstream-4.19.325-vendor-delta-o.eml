diff --git a/drivers/soc/mediatek/devmpu/devmpu_trace.h b/drivers/soc/mediatek/devmpu/devmpu_trace.h
new file mode 100644
index 000000000..0d178527f
--- /dev/null
+++ b/drivers/soc/mediatek/devmpu/devmpu_trace.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2022 MediaTek Inc.
+ */
