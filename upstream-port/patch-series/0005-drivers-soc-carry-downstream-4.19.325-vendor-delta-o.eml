+static char *perm_to_string(uint32_t perm)
+{
+	if (perm == 0x0)
+		return "NO_PROTECTION";
+	else if (perm == 0x1)
+		return "SECURE_RW_ONLY";
+	else if (perm == 0x2)
+		return "SECURE_RW_NS_R_ONLY";
+	else if (perm == 0x3)
+		return "FORBIDDEN";
+	else
+		return "NO_PERM_CTRL";
+}
