+#define INFRA_VIO_DBG_W_VIO_START_BIT		22
+#define INFRA_VIO_DBG_R_VIO			0x00800000
+#define INFRA_VIO_DBG_R_VIO_START_BIT		23
+#define INFRA_VIO_ADDR_HIGH			0x0F000000
+#define INFRA_VIO_ADDR_HIGH_START_BIT		24
