+ * zero). So reusing mt6779_compat is a field-by-field match, not a family guess.
+ * The board DTB also supplies the clocks mainline asks for by name: "source" (via
+ * topckgen CLK_TOP_MSDC50_0), "hclk" and "source_cg" (infracfg CLK_IFR_MSDC0 /
+ * CLK_IFR_MSDC0_SRC), plus an unused "crypto_clk", and the second reg resource
+ * (msdc_top at 0x11cd0000), which the driver maps as its second resource.
+ */
+	{ .compatible = "mediatek,mt6768-mmc", .data = &mt6779_compat},
 	{ .compatible = "mediatek,mt6779-mmc", .data = &mt6779_compat},
 	{}
 };
diff --git a/drivers/regulator/mt6358-regulator.c b/drivers/regulator/mt6358-regulator.c
index eb8027813..f966c4692 100644
--- a/drivers/regulator/mt6358-regulator.c
+++ b/drivers/regulator/mt6358-regulator.c
@@ -500,13 +500,44 @@ static int mt6358_regulator_probe(struct platform_device *pdev)
 {
 	struct mt6397_chip *mt6397 = dev_get_drvdata(pdev->dev.parent);
 	struct regulator_config config = {};
+	struct of_regulator_match *matches;
 	struct regulator_dev *rdev;
-	int i;
+	struct device_node *np = pdev->dev.of_node;
+	int i, ret;
+
+	/*
+	 * Bind every regulator to its own DT child node (mt6358-regulator node's
+	 * children: buck_vdram1, ldo_vemc, ...).  Without this, each rdev inherits the
+	 * MFD cell's of_node, so a consumer's `vmmc-supply = <&ldo_vemc>` phandle - which
+	 * is how this board's DTB describes PMIC power rails, e.g. MSDC0's VMMC/VQMMC -
+	 * matches no regulator and the consumer defers forever.  The match names are the
+	 * driver's own desc.name strings (MT6358_BUCK("buck_vdram1"), MT6358_LDO_VEMC ->
+	 * "ldo_vemc"), which are the vendor's names, so this is a lookup table the DT and
+	 * this driver already agree on rather than a new binding.  Children that are
+	 * absent simply keep config.of_node == NULL, i.e. today's behaviour.
+	 */
+	matches = devm_kcalloc(&pdev->dev, MT6358_MAX_REGULATOR, sizeof(*matches),
+			       GFP_KERNEL);
+	if (!matches)
+		return -ENOMEM;
+	for (i = 0; i < MT6358_MAX_REGULATOR; i++)
+		matches[i].name = mt6358_regulators[i].desc.name;
+	if (np) {
+		ret = of_regulator_match(&pdev->dev, np, matches,
+					 MT6358_MAX_REGULATOR);
+		if (ret < 0) {
+			dev_err(&pdev->dev, "Error matching regulators: %d\n",
+				ret);
+			return ret;
+		}
+	}
 
 	for (i = 0; i < MT6358_MAX_REGULATOR; i++) {
 		config.dev = &pdev->dev;
 		config.driver_data = &mt6358_regulators[i];
 		config.regmap = mt6397->regmap;
+		if (np)
+			config.of_node = matches[i].of_node;
 
 		rdev = devm_regulator_register(&pdev->dev,
 					       &mt6358_regulators[i].desc,
