diff --git a/drivers/iio/adc/Kconfig b/drivers/iio/adc/Kconfig
index 1dca0e82b..270761434 100644
--- a/drivers/iio/adc/Kconfig
+++ b/drivers/iio/adc/Kconfig
@@ -716,6 +716,23 @@ config MEDIATEK_MT6360_ADC
 	  is used in smartphones and tablets and supports a 11 channel
 	  general purpose ADC.
 
+config MT635X_AUXADC
+	bool "MediaTek MT635x PMIC AUXADC (vendor variant)"
+	depends on MFD_MT6397 && IIO
+	help
+	  Say yes here to build support for the AUXADC converter inside the
+	  MT635x family of MediaTek PMICs, as implemented by MediaTek's own
+	  driver (transplanted from the 4.19 BSP).  It exposes the PMIC-side
+	  channels - battery voltage, battery temperature, chip temperature,
+	  VCDT - as IIO channels for io-channel consumers such as chargers and
+	  fuel gauges, and additionally exports auxadc_priv_read_channel() /
+	  auxadc_get_r_ratio() / pmic_auxadc_chip_init() for in-tree vendor
+	  consumers that do not go through IIO.
+
+	  This is the variant the board's 4.19 defconfig builds
+	  (CONFIG_MT635X_AUXADC=y); the other one, MEDIATEK_MT635X_AUXADC, was
+	  left unset by that same defconfig.
+
 config MEDIATEK_MT6577_AUXADC
 	tristate "MediaTek AUXADC driver"
 	depends on ARCH_MEDIATEK || COMPILE_TEST
