From e2c2b92578baf3ea9cff3cab6de8a5f14f6a60a3 Mon Sep 17 00:00:00 2001
From: Zenium Upstream Port <upstream-port@zenium.invalid>
Date: Sat, 5 Sep 2026 03:26:32 +0000
Subject: [PATCH 73/77] Revert "rtc: mt6397: carry the vendor power-on / nvram
 RTC rework"

This removes the +958-line vendor rewrite of rtc-mt6397.c (and the
rtc_set_alarm_poweron() helper in drivers/rtc/interface.c that only served it) from
the port. It was applied by the hunk engine because the surroundings matched, but the
feature needs the 4.19 mt6397 core: `rtc->spare[]` regmap fields, `rtc->pm_nb`,
`nvmem_cfg` - none of which exist in 5.15's include/linux/mfd/mt6397/core.h, and
drivers/mfd/mt6397-core.c was never ported to create them.

Nothing noticed for 24 build passes because CONFIG_RTC_DRV_MT6397 was off in the test
config; `upstream-port/bin/hwenable.py` enabled it after matching
`mediatek,mt6358-rtc`/`mediatek,mt6397*` in the built DTB, and the file failed at once
with "no member named 'spare' in struct mt6397_rtc". That is the general lesson for
this port, and the reason the tool exists: ported content behind an off Kconfig is
*uncompiled*, not verified. Keeping mainline's driver is the coherent state - PMIC
RTC works through it - and the vendor power-on-alarm/nvram behaviour is listed as
driver work with its dependency named (mt6397 core + header), rather than shipped
broken.
---
 drivers/rtc/interface.c  |  24 -
 drivers/rtc/rtc-mt6397.c | 958 ++-------------------------------------
 2 files changed, 42 insertions(+), 940 deletions(-)

diff --git a/drivers/rtc/interface.c b/drivers/rtc/interface.c
index 7c8c2f926..5a3e0f3fc 100644
--- a/drivers/rtc/interface.c
+++ b/drivers/rtc/interface.c
@@ -503,30 +503,6 @@ int rtc_set_alarm(struct rtc_device *rtc, struct rtc_wkalrm *alarm)
 }
 EXPORT_SYMBOL_GPL(rtc_set_alarm);
 
-int rtc_set_alarm_poweron(struct rtc_device *rtc, struct rtc_wkalrm *alarm)
-{
-	int err;
-
-	err = rtc_valid_tm(&alarm->time);
-	if (err != 0)
-		return err;
-
-	err = mutex_lock_interruptible(&rtc->ops_lock);
-	if (err)
-		return err;
-
-	if (!rtc->ops)
-		err = -ENODEV;
-	else if (!rtc->ops->set_alarm)
-		err = -EINVAL;
-	else
-		err = rtc->ops->set_alarm(rtc->dev.parent, alarm);
-
-	mutex_unlock(&rtc->ops_lock);
-	return err;
-}
-EXPORT_SYMBOL_GPL(rtc_set_alarm_poweron);
-
