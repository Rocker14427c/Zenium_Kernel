-	int ret;
-	u8 *buf = val;
-
-	mutex_lock(&rtc->lock);
-
-	for (; bytes; bytes--) {
-		ret = regmap_field_read(rtc->spare[offset++], &ival);
-		if (ret)
-			goto out;
-		*buf++ = (u8)ival;
-	}
-out:
-	mutex_unlock(&rtc->lock);
-	return ret;
