index 3883d4cf7..8c9709d1d 100644
--- a/kernel/bpf/cgroup.c
+++ b/kernel/bpf/cgroup.c
@@ -1289,6 +1289,718 @@ const struct bpf_verifier_ops cg_dev_verifier_ops = {
