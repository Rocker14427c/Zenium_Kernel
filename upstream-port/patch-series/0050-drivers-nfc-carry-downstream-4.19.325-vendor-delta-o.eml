+obj-$(CONFIG_NXP_P73_DEVICES)	+= p73-spi-nq330/
+obj-$(CONFIG_OPLUS_NFC)         += oplus_nfc/
+obj-$(CONFIG_ST_NFC_CHIP_SUPPORT)  += st21nfc-i2c/
+obj-$(CONFIG_NFC_ST54_SPI)         += st54-spi/
 obj-$(CONFIG_NFC_VIRTUAL_NCI)	+= virtual_ncidev.o
