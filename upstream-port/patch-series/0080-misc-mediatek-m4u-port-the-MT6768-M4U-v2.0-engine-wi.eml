+		aee_kernel_warning_api(__FILE__, __LINE__,              \
+					DB_OPT_MMPROFILE_BUFFER |       \
+					DB_OPT_DUMP_DISPLAY,            \
+					m4u_name,                       \
+					"[M4U] error"string, ##args);   \
+		pr_info("[M4U] error:"string, ##args);                  \
+	} while (0)
