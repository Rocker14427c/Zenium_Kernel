+		M4ULOG_HIGH("%s, %d, invalid id=%d\n",
+		    __func__, __LINE__, m4u_id);
+		return 0;
+	}
+
+	m4u_get_pfh_tlb(m4u_id, set, page, way, &tlb);
+	return tlb.desc;
+}
