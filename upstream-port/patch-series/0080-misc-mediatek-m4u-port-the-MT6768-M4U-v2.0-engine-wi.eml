+			__func__, alloc_port, mva, size, *(int *)data);
+	else
+		m4u_err("%s port=%d, mva=0x%x, size=0x%x\n",
+			__func__, alloc_port, mva, size);
+
+	return M4U_CALLBACK_HANDLED;
+}
