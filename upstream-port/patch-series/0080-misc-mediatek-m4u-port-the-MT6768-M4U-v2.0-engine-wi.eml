+/*
+ * Port note (5.15): /proc files stopped using struct file_operations in v5.6,
+ * when the proc_ops interface was introduced, and struct proc_ops has no
+ * .owner field (the proc_dir_entry keeps the module reference).  The vendor's
+ * generic_file_llseek() becomes default_llseek(), the mainline choice for proc
+ * attributes; simple_attr_* ignore the file position either way, so the
+ * behaviour of these nodes is unchanged.  The local_inode copy below is still
+ * needed because 5.15's simple_attr_open() reads inode->i_private, and
+ * proc_create_data() only stores the data in PDE_DATA().
+ */
+#define DEFINE_PROC_ATTRIBUTE(__fops, __get, __set, __fmt)		  \
+static int __fops ## _open(struct inode *inode, struct file *file)	  \
+{									  \
+	struct inode local_inode = *inode;				  \
+									  \
+	local_inode.i_private = PDE_DATA(inode);			  \
+	__simple_attr_check_format(__fmt, 0ull);			  \
+	return simple_attr_open(&local_inode, file, __get, __set, __fmt); \
+}									  \
+static const struct proc_ops __fops = {				  \
+	.proc_open	 = __fops ## _open,				  \
+	.proc_release	 = simple_attr_release,			  \
+	.proc_read	 = simple_attr_read,				  \
+	.proc_write	 = simple_attr_write,				  \
+	.proc_lseek	 = default_llseek,				  \
+}
+#endif
