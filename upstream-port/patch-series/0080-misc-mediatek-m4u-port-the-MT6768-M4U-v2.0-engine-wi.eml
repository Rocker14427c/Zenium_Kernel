+#define __M4ULOG(level, string, args...) \
+	do {\
+		if (level > gM4U_log_level) {\
+			if (level > gM4U_log_to_uart)\
+				pr_info("[M4U] "string, ##args);\
+			else\
+				pr_debug("[M4U] "string, ##args);\
+		} \
