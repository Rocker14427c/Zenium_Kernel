diff --git a/drivers/misc/mediatek/m4u/Kconfig b/drivers/misc/mediatek/m4u/Kconfig
new file mode 100644
index 000000000..62578b2d9
--- /dev/null
+++ b/drivers/misc/mediatek/m4u/Kconfig
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# MediaTek MT6768 M4U (multimedia IOMMU)
+#
+
+config MTK_M4U
+	bool "MT6768 M4U (multimedia memory management unit)"
+	depends on MTK_SMI_EXT
+	help
+	  Say Y here to enable the MediaTek M4U v2.0 multimedia IOMMU for
+	  MT6768-class SoCs.  M4U translates the media cores' MVA space into
+	  physical addresses and programs the SMI local arbiter ports, so the
+	  vendor SMI support (CONFIG_MTK_SMI_EXT) is required.
+
+	  The driver binds the vendor "mediatek,m4u" DT node (plus the
+	  "mediatek,iommu_v0" / "mediatek,perisys_iommu" larb compatibles that
+	  M4U's own m4u_reg_init() maps directly) and keeps the vendor MVA and
+	  page-table semantics, including the hardware-specific page-table walk
+	  cache maintenance.
+
+	  Note the differences from the vendor 4.19 tree: the legacy
+	  /dev/ion-based M4U<->ION bridge is not part of this build (M4U itself
+	  does not use ION; the multimedia allocation ABI stays unavailable
+	  until its clients are ported), and M4U's mmprofile trace events are
+	  compiled out because CONFIG_MMPROFILE is not set.
+
+	  If unsure, say N.
diff --git a/drivers/misc/mediatek/m4u/Makefile b/drivers/misc/mediatek/m4u/Makefile
