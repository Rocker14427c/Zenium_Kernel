@@ -0,0 +1,17 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# MT6768 M4U: 2.0 common layer + mt6768 hardware layer.
+#
+
+# Include paths follow the BSP layout (mt6768 headers use unqualified and
+# <mt-plat/...> style includes); drivers/memory carries smi_public.h and
+# drivers/misc/mediatek/mmp carries the mmprofile API header, whose
+# !CONFIG_MMPROFILE branch provides the no-op tracing API this build uses.
+subdir-ccflags-y += -I$(srctree)/drivers/misc/mediatek/m4u/2.0 \
+		    -I$(srctree)/drivers/misc/mediatek/m4u/mt6768 \
+		    -I$(srctree)/drivers/misc/mediatek/include \
+		    -I$(srctree)/drivers/misc/mediatek/include/mt-plat \
+		    -I$(srctree)/drivers/misc/mediatek/mmp \
+		    -I$(srctree)/drivers/memory
+
+obj-$(CONFIG_MTK_M4U) += 2.0/ mt6768/
