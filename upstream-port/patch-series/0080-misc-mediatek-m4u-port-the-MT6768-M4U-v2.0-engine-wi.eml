+static void m4u_early_suspend(void)
+{
+	m4u_err("%s +, %d\n", __func__, m4u_tee_en);
+
+	if (m4u_tee_en)
+		m4u_reg_backup_sec();
+	m4u_err("%s -\n", __func__);
+}
+
+static void m4u_late_resume(void)
+{
+	m4u_err("%s +, %d\n", __func__, m4u_tee_en);
+
+	if (m4u_tee_en)
+		m4u_reg_restore_sec();
+
+	m4u_err("%s -\n", __func__);
+}
