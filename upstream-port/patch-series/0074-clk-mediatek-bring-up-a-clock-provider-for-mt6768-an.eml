From 616ddfa52fce9c6d24be2ddf039bde7035f2a3db Mon Sep 17 00:00:00 2001
From: Zenium Upstream Port <upstream-port@zenium.invalid>
Date: Sat, 5 Sep 2026 04:09:45 +0000
Subject: [PATCH 74/82] clk: mediatek: bring up a clock provider for mt6768,
 and audit it against the board DTB

Everything on this SoC that is not the arch timer needs a clock, so the clock provider is
the head of the dependency chain: 5.15 has clk-mt6765 but no mt6768, and with no provider
every `clocks = <&phandle N>` consumer defers forever. The ported board DTB describes four
root providers:

    topckgen@10000000     compatible "mediatek,topckgen"       #clock-cells = <1>
    apmixed@1000c000      compatible "mediatek,apmixed"        #clock-cells = <1>
    infracfg_ao@10001000  "mediatek,common-infracfg_ao"       #clock-cells = <1>
    pericfg@10003000      compatible "mediatek,pericfg"        #clock-cells = <1>

Those are not upstream binding names, and they are not invented here either: they are the
strings the vendor MTK CCF driver's own of_match table lists (it matches "mediatek,apmixed",
"mediatek,topckgen", "mediatek,infracfg_ao", "mediatek,pericfg", "mediatek,audio",
"mediatek,mt6768-camsys", "mediatek,gce", "mediatek,venc_gcon", "mediatek,mipi_rx_ana_csi*"),
which is what makes this DTB readable at all. The file transplants with no source edits
because 5.15 still carries the clk-mtk generation it was written against
(mtk_clk_register_gates(struct device_node *node, ...) - the pre-6.x signature), and the
clock IDs it registers come from the same include/dt-bindings/clock/mt6768-clk.h that the
board DTS was written against, so DT indices and driver IDs agree by construction.

  * drivers/clk/mediatek/clk-mt6768.c        3,550 lines, vendor, verbatim
  * drivers/clk/mediatek/clk-mt6768-pg.c/.h  4,030 lines: MTCMOS power gating of the
    multimedia/camera paths, i.e. the part that makes suspend actually save power
  * drivers/clk/mediatek/clk-mtk-v1.{c,h}    68 lines, the BSP's clk/mtcmos spinlocks.
    Its header guard is renamed __DRV_CLK_MTK_H -> __DRV_CLK_MTK_V1_H: 5.15's clk-mtk.h
    uses that exact guard, clk-mt6768-pg.c includes both, and with the original name
    whichever came first silently swallowed the other.
  * Kconfig: COMMON_CLK_MT6768 in 5.15's idiom (depends on (ARCH_MEDIATEK && ARM64) ||
    COMPILE_TEST, select COMMON_CLK_MEDIATEK, default MACH_MT6768 - the vendor keys the
    same default off MACH_MT6768, the symbol this port defines for that purpose).
  * Not taken from the vendor Makefile: clkdbg.c, clkchk-mt6768.c, clkdbg-mt6768.c,
    mt6768_clkmgr.c. The first three are debug companions clk-mt6768.c does not reference;
    mt6768_clkmgr.c is the pre-CCF clock manager this driver replaces, and porting it would
    mean two providers for the same DT nodes.

One link error was real, and is handled at its actual boundary instead of around it:
clk-mt6768-pg.c calls polling_rdma_output_line_is_not_zero(), defined in the vendor *display*
driver (drivers/misc/mediatek/video/mt6768/dispsys/ddp_rdma_ex.c:1588), where it spins on
DISP_RDMA_OUT_LINE_CNT so an mm_sel re-parent cannot land mid-frame on a command-mode panel.
The video subtree is not ported, so the reference is answered by a __weak no-op in the pg
file: with no display driver bound mm_polling() is already gated off by subsys_is_on(SYS_DIS),
and deleting the call - or switching MT_MTCMOS_ENABLE off, which is the vendor's own bringup
configuration - would discard the reason this file exists. The display port's strong
definition overrides the stub when it lands. Stated loss if it never does: transient panel
underflow on mid-frame mm_sel switches in command mode.

Compile/link evidence, device config with COMMON_CLK_MT6768=y: 0 errors, 0 warnings from the
ported files; vmlinux links; Image grows 26,894,344 -> 26,963,976 bytes; and
`nm --defined-only vmlinux | grep -ciE clk_mt6768|mtk_is_mtcmos_enable|pg_` = 238, so the
driver and its pg companion are in the image rather than merely in the tree. The DT-side
audit (upstream-port/bin/clkaudit.py, report/clkaudit.json) is what makes "enabled" mean
something here: 231 clock references in this board's DTB, 209 resolve to an ID the driver
registers, 0 foreign-numbering, 0 cross-domain collisions, 22 pointing at providers no 5.15
driver claims.
---
 drivers/clk/mediatek/Kconfig         |   15 +
 drivers/clk/mediatek/Makefile        |    1 +
 drivers/clk/mediatek/clk-mt6768-pg.c | 4052 ++++++++++++++++++++++++++
 drivers/clk/mediatek/clk-mt6768-pg.h |   60 +
 drivers/clk/mediatek/clk-mt6768.c    | 3550 ++++++++++++++++++++++
 drivers/clk/mediatek/clk-mtk-v1.c    |   34 +
 drivers/clk/mediatek/clk-mtk-v1.h    |   49 +
 7 files changed, 7761 insertions(+)
 create mode 100644 drivers/clk/mediatek/clk-mt6768-pg.c
 create mode 100644 drivers/clk/mediatek/clk-mt6768-pg.h
 create mode 100644 drivers/clk/mediatek/clk-mt6768.c
 create mode 100644 drivers/clk/mediatek/clk-mtk-v1.c
 create mode 100644 drivers/clk/mediatek/clk-mtk-v1.h

diff --git a/drivers/clk/mediatek/Kconfig b/drivers/clk/mediatek/Kconfig
index 439b7c8d0..ab77bacab 100644
--- a/drivers/clk/mediatek/Kconfig
+++ b/drivers/clk/mediatek/Kconfig
@@ -125,6 +125,21 @@ config COMMON_CLK_MT6765
        help
          This driver supports MediaTek MT6765 basic clocks.
 
+config COMMON_CLK_MT6768
+	bool "Clock driver for MediaTek MT6768"
+	depends on (ARCH_MEDIATEK && ARM64) || COMPILE_TEST
+	select COMMON_CLK_MEDIATEK
+	default MACH_MT6768
+	help
+	  This driver supports MediaTek MT6768 basic clocks (apmixed, topckgen,
+	  infracfg_ao, pericfg, audio, camsys, imgsys, gce, mmsys_config, mfgcfg,
+	  venc/vdec gcon, mipi_rx_ana_*). It is the CCF driver the 4.19 MediaTek
+	  BSP ships for this SoC, so its of_match table uses the vendor DT
+	  compatible strings ("mediatek,topckgen", "mediatek,pericfg", ...) that
+	  this board's device tree actually carries - no binding is invented here.
+	  The vendor's debug/legacy companions (clkdbg, clkchk, mt6768_clkmgr) and
+	  clk-mtk-v1 are not ported: the file does not reference them.
+
 config COMMON_CLK_MT6765_AUDIOSYS
        bool "Clock driver for MediaTek MT6765 audiosys"
        depends on COMMON_CLK_MT6765
diff --git a/drivers/clk/mediatek/Makefile b/drivers/clk/mediatek/Makefile
index 15bc045f0..7261e01ae 100644
--- a/drivers/clk/mediatek/Makefile
+++ b/drivers/clk/mediatek/Makefile
