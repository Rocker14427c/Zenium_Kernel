+static int sys_get_state_op(struct subsys *sys)
+{
+	unsigned int sta = clk_readl(PWR_STATUS);
+	unsigned int sta_s = clk_readl(PWR_STATUS_2ND);
+
+	return (sta & sys->sta_mask) && (sta_s & sys->sta_mask);
+}
