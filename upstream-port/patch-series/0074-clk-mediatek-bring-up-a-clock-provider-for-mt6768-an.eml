+static int subsys_is_on(enum subsys_id id)
+{
+	int r;
+	struct subsys *sys = id_to_sys(id);
+
+	WARN_ON(!sys);
+
+	r = sys->ops->get_state(sys);
+
+#if MT_CCF_DEBUG
+	pr_debug("[CCF] %s:%d, sys=%s, id=%d\n", __func__, r, sys->name, id);
+#endif				/* MT_CCF_DEBUG */
+
+	return r;
+}
