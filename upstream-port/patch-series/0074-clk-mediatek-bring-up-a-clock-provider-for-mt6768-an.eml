+/*
+ * Workaround for mm dvfs: Poll mm rdma before clkmux switching.
+ *
+ * PORT NOTE (4.19 -> 5.15). The definition of this function is not in the clock
+ * driver: the vendor tree defines it in the display driver
+ * (drivers/misc/mediatek/video/mt6768/dispsys/ddp_rdma_ex.c:1588), where it spins on
+ * DISP_RDMA_OUT_LINE_CNT while the primary panel runs in command mode, so that an
+ * mm_sel re-parent cannot land in the middle of an RDMA-driven line. That video
+ * subtree is not part of this port, which left the reference undefined at link time.
+ *
+ * It is satisfied here by a __weak no-op rather than by deleting the call or by
+ * turning MT_MTCMOS_ENABLE off: with no display driver bound there is no RDMA in
+ * flight (and mm_polling() is already gated on subsys_is_on(SYS_DIS)), so waiting for
+ * something that cannot be running is not a hardware behaviour we can reproduce, and
+ * disabling MTCMOS to dodge a link error would throw away the whole point of this
+ * file. When the display side lands, its strong definition takes precedence and the
+ * wait comes back with it - deferred, not lost.
+ *
+ * If display is ever ported and this stub still wins the link, the concrete loss is a
+ * transient panel underflow when mm_sel switches mid-frame in command mode.
+ */
+void polling_rdma_output_line_is_not_zero(void);
+__weak void polling_rdma_output_line_is_not_zero(void)
+{
+}
+
+void mm_polling(struct clk_hw *hw)
+{
+	const char *clk_name = __clk_get_name(hw->clk);
+
+	if (clk_name) {
+		if (!strcmp(clk_name, "mm_sel") && subsys_is_on(SYS_DIS))
+			polling_rdma_output_line_is_not_zero();
+	}
+}
