+	PLL(CLK_APMIXED_APLL1, "apll1", 0x0308, 0x0318, BIT(0),
+		0, 32, 8, 0x030C, 24, 0x0040, 0x000C, 0, 0x0310, 0),
+	PLL(CLK_APMIXED_MMPLL, "mmpll", 0x031C, 0x0328, BIT(0),
