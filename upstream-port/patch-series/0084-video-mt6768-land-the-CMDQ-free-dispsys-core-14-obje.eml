+static int _disp_init_cmdq_slots(cmdqBackupSlotHandle *pSlot,
+	int count, int init_val)
+{
+	int i;
+
+	cmdqBackupAllocateSlot(pSlot, count);
+
+	for (i = 0; i < count; i++)
+		cmdqBackupWriteSlot(*pSlot, i, init_val);
+
+	return 0;
+}
