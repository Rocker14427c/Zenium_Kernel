+static int _disp_get_cmdq_slots(cmdqBackupSlotHandle Slot,
+	unsigned int slot_index, unsigned int *value)
+{
+	int ret;
+
+	ret = cmdqBackupReadSlot(Slot, slot_index, value);
+
+	/* cmdq get slot fail */
+	if (ret)
+		DDPERR("DISP CMDQ get slot failed:%d\n", ret);
+
+	return ret;
+}
