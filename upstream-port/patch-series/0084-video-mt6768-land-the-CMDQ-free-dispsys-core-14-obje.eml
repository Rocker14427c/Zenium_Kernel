+char *ddp_get_fmt_name(enum DISP_MODULE_ENUM module, unsigned int fmt)
+{
+	if (module == DISP_MODULE_WDMA0) {
+		switch (fmt) {
+		case 0:
+			return "rgb565";
+		case 1:
+			return "rgb888";
+		case 2:
+			return "rgba8888";
+		case 3:
+			return "argb8888";
+		case 4:
+			return "uyvy";
+		case 5:
+			return "yuy2";
+		case 7:
+			return "y-only";
+		case 8:
+			return "iyuv";
+		case 12:
+			return "nv12";
+		default:
+			DDPDUMP("%s: unknown fmt=%d, module=%d\n",
+				__func__, fmt, module);
+			return "unknown";
+		}
+	} else if (module == DISP_MODULE_OVL0) {
+		switch (fmt) {
