-# the video include dirs), taken from the vendor rule verbatim otherwise.
+# Generated by upstream-port/bin/l2slice.py. The ccflags list below is the stock
+# drivers/misc/mediatek/video/mt6768/dispsys/Makefile include set, filtered to the
