+static char *_logger_pr_type_spy(enum DPREC_LOGGER_PR_TYPE type)
+{
+	switch (type) {
+	case DPREC_LOGGER_ERROR:
+		return "error";
+	case DPREC_LOGGER_FENCE:
+		return "fence";
+	case DPREC_LOGGER_DEBUG:
+		return "dbg";
+	case DPREC_LOGGER_DUMP:
+		return "dump";
+	case DPREC_LOGGER_STATUS:
+		return "status";
+	default:
+		return "unknown";
+	}
+}
