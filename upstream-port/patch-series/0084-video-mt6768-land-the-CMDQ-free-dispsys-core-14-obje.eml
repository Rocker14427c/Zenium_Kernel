+static void _dprec_stub_irq(unsigned int irq_bit)
+{
+	/* DISP_REG_SET(NULL,DISP_REG_CONFIG_MUTEX_INTEN,0xffffffff); */
+	if (irq_bit == DDP_IRQ_DSI0_EXT_TE) {
+		dprec_logger_trigger(DPREC_LOGGER_DSI_EXT_TE, irq_bit, 0);
