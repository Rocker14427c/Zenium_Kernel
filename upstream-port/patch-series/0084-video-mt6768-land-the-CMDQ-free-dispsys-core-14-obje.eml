+#define CMDQ_DELAY_SET_RESULT_CPR	(2)
+#define CMDQ_DELAY_SET_MAX_CPR		(3)
+#define CMDQ_DELAY_THD_SIZE		(64 * 64) /* delay inst in bytes */
