+static unsigned long long get_current_time_us(void)
+{
+	unsigned long long time = sched_clock();
+	/* PORT(v5.15.220): 4.19.325 used do_gettimeofday() on a struct timeval. Mainline removed
+	 * both (struct timeval survives only in uapi), so this uses ktime_get_real_ts64(), which is
+	 * the same wall-clock source; the returned value keeps the vendor's microsecond arithmetic
+	 * exactly (tv_nsec / 1000 replaces tv_usec).
+	 */
+	struct timespec64 t;
+
+	/* return do_div(time,1000); */
+	return time;
+
+	ktime_get_real_ts64(&t);
+	return (t.tv_sec & 0xFFF) * 1000000 + t.tv_nsec / 1000;
+}
