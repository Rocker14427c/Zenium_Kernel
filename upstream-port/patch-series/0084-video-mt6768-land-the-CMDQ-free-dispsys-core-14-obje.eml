+#define DDPDUMP(fmt, ...)						\
+	do {								\
+		if (ddp_debug_analysis_to_buffer()) {			\
+			static char log[512] = {'\0'};			\
+			scnprintf(log, 511, fmt, ##__VA_ARGS__);	\
