+int dpmgr_path_enable_irq(disp_path_handle dp_handle, void *cmdq_handle,
+	enum DDP_IRQ_LEVEL irq_level)
+{
+	int i = 0;
+	int ret = 0;
+	int module_name, module_num;
+	struct ddp_path_handle *handle;
+	int *modules;
+	struct DDP_MODULE_DRIVER *mod_drv;
+
+	if (!dp_handle) {
