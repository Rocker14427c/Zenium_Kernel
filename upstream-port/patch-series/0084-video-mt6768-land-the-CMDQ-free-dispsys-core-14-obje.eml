+#define CMDQ_POLLING_TPR_MASK_BIT	(10)
+#define CMDQ_SRAM_ADDR(CPR_OFFSRT)	\
+	(((CMDQ_SRAM_STRAT_ADDR + CPR_OFFSRT / 2) << 3) + 0x001)
+#define CMDQ_CPR_OFFSET(SRAM_ADDR)	\
+	(((SRAM_ADDR >> 3) - CMDQ_SRAM_STRAT_ADDR) * 2)
