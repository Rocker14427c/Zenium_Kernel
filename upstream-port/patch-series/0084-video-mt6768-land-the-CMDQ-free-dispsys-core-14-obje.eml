+	switch (fmt) {
+	case UFMT_PARGB8888:
+		old_fmt = 1;
+		break;
+	case UFMT_PABGR8888:
+		old_fmt = 1;
+		break;
+	case UFMT_PRGBA8888:
+		old_fmt = 1;
+		break;
+	case UFMT_PBGRA8888:
+		old_fmt = 1;
