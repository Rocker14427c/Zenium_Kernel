+	_control.cmm_dump = (option & (1 << DPREC_DEBUG_BIT_CMM_DUMP_SWITCH));
+	_control.cmm_dump_use_va = (option &
+				(1 << DPREC_DEBUG_BIT_CMM_DUMP_VA));
+	_control.systrace = (option & (1 << DPREC_DEBUG_BIT_SYSTRACE));
+
+	return 0;
+}
