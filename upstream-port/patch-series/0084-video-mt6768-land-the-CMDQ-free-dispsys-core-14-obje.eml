+static void process_dbg_cmd(char *cmd)
+{
+	char *tok;
+
+	DDPDBG("cmd: %s\n", cmd);
+	memset(dbg_buf, 0, sizeof(dbg_buf));
+	while ((tok = strsep(&cmd, " ")) != NULL)
+		process_dbg_opt(tok);
+}
