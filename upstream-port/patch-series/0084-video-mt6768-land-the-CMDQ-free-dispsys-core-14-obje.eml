+static inline unsigned int virq_to_hwirq(unsigned int virq)
+{
+	struct irq_desc *desc;
+	unsigned int hwirq = 0;
+
+	desc = irq_to_desc(virq);
+
+	if (!desc) {
+		WARN_ON(1);
+		return 0;
+	}
+
+		hwirq = gic_irq(&desc->irq_data);
+
+	return hwirq;
