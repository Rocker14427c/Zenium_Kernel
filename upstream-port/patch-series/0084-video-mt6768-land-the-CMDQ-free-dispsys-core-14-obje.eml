+	((block)		<< _UFMT_BLOCK_SHIT)	| \
+	((vdo)			<< _UFMT_VDO_SHIFT)	| \
+	((format)		<< _UFMT_FORMAT_SHIFT)	| \
+	((byteswap)		<< _UFMT_BYTESWAP_SHIFT)	| \
+	((rgbswap)		<< _UFMT_RGBSWAP_SHIFT)	| \
+	((id)			<< _UFMT_ID_SHIFT))
