+#include "ddp_debug.h"
+#include "disp_drv_log.h"
 
 #ifndef LOG_TAG
 #define LOG_TAG
 #endif
 
-#define DISPINFO(string, args...)					\
+#define DDPSVPMSG(fmt, args...) DISPMSG(fmt, ##args)
+
+#define DISP_LOG_I(fmt, args...)					\
 	do {								\
-		pr_debug("[DISP]" string, ##args);			\
+		dprec_logger_pr(DPREC_LOGGER_DEBUG, fmt, ##args);	\
+		if (g_mobilelog)					\
+			pr_err("[DDP/"LOG_TAG"]"fmt, ##args);		\
 	} while (0)
 
-#define DISPMSG(string, args...)	pr_debug("[DISP]" string, ##args)
-#define DISPCHECK(string, args...)	pr_debug("[DISP]" string, ##args)
+#define DISP_LOG_V(fmt, args...)					\
+	do {								\
+		if (ddp_debug_dbg_log_level() >= 2) {			\
+			DISP_LOG_I(fmt, ##args);			\
+		}							\
+	} while (0)
 
-#define DISPWARN(string, args...)						\
-	do {									\
-		pr_info("[DISP][%s #%d]warn:" string,				\
-				__func__, __LINE__, ##args);			\
+#define DISP_LOG_D(fmt, args...)					\
+	do {								\
+		if (ddp_debug_dbg_log_level()) {			\
+			DISP_LOG_I(fmt, ##args);			\
+		}							\
 	} while (0)
 
-#define DISPERR(string, args...)						\
-	do {									\
-		pr_info("[DISP][%s #%d]ERROR:" string,				\
-				__func__, __LINE__, ##args);			\
+#define DISP_LOG_W(fmt, args...)					\
+	do {								\
+		dprec_logger_pr(DPREC_LOGGER_DEBUG, fmt, ##args);	\
+		pr_err("[DDP/"LOG_TAG"]warn:"fmt, ##args);		\
 	} while (0)
 
-#define DDPDBG(fmt, args...)		pr_debug("[DDP/" LOG_TAG "]" fmt, ##args)
-#define DDPMSG(fmt, args...)		pr_info("[DDP/" LOG_TAG "]" fmt, ##args)
-#define DDPERR(fmt, args...)		pr_err("[DDP/" LOG_TAG "]" fmt, ##args)
+#define DISP_LOG_E(fmt, args...)					\
+	do {								\
+		dprec_logger_pr(DPREC_LOGGER_ERROR, fmt, ##args);	\
+		pr_err("[DDP/"LOG_TAG"]error:"fmt, ##args);		\
+	} while (0)
+
+#define DDPIRQ(fmt, args...)						\
+	do {								\
+		if (ddp_debug_irq_log_level()) {			\
+			DISP_LOG_I(fmt, ##args);			\
+		}							\
