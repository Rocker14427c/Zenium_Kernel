+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/mmc/mt6768-msdc.h>
+#include <dt-bindings/memory/mt6768-larb-port.h>
+#include <dt-bindings/pinctrl/mt6768-pinfunc.h>
