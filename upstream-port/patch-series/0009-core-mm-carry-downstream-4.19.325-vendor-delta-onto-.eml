+#define KD_VALUE_LEN (32)
+#define DATA_LEN (PAGE_SIZE)
+#define ALL_KMALLOC_HIGH (KMALLOC_SHIFT_HIGH * 2 + 1)
+#define CACHE_INDEX(index) ((index) % (KMALLOC_SHIFT_HIGH + 1))
+#define CACHE_TYPE(index) ((index) / (KMALLOC_SHIFT_HIGH + 1))
