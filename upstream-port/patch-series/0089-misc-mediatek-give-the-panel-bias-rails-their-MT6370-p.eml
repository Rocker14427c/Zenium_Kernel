+	MT6370_PMU_IRQ_MAPPING(chg_vbatov, 14),
+	MT6370_PMU_IRQ_MAPPING(chg_vbusov, 15),
+	MT6370_PMU_IRQ_MAPPING(ts_bat_cold, 20),
