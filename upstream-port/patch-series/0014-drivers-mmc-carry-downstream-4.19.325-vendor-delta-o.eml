+/*
+ *	check status register
+ */
+void mmc_do_status(struct mmc_host *host)
+{
+	mmc_prep_chk_mrq(host);
+	trace_mmc_request_start(host, &host->chk_mrq);
+	host->ops->request(host, &host->chk_mrq);
+}
