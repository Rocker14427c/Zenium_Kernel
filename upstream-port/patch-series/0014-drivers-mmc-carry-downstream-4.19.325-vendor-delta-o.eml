+static void msdc_ops_card_event(struct mmc_host *mmc)
+{
+	struct msdc_host *host = mmc_priv(mmc);
+
+	host->power_cycle_cnt = 0;
+	host->data_timeout_cont = 0;
+	host->is_autok_done = 0;
+	msdc_reset_bad_sd_detecter(host);
